#!/usr/bin/env bash
# pretooluse_vault_check.sh - Phase 2c v2 PreToolUse vault write gate
#
# Installed at: ~/.claude/hooks/pretooluse_vault_check.sh
# Trigger     : Claude Code PreToolUse for Write|Edit
# Args        : $1 = tool_name (e.g. "Write" or "Edit")
#               $2 = tool_input (JSON string with file_path / content / etc.)
# Exit codes  : 0  = allow (out of scope, or schema_lint PASS)
#               2  = block (schema_lint REJECT or NEEDS_HUMAN — Claude Code halts)
#               1  = internal error (fail-closed — also halts)
#
# Scope       : Writes whose file_path lives under a Vault OneDrive path
#               (D|E:/OneDrive/VPS-Obsidian) or a morgan-ai-rules clone.
# Performance : Designed to finish in < 2 s. Single python3 call does the work
#               so we pay one cold start, not five.
# Failure mode: fail-closed when schema_lint is locatable but errors out.
#               Silently allow when schema_lint cannot be located at all (the
#               installer's job is to wire MORGAN_AI_RULES_ROOT or auto-detect).

set -uo pipefail

TOOL_NAME="${1:-}"
TOOL_INPUT="${2:-}"

case "$TOOL_NAME" in
  Write|Edit) ;;
  *) exit 0 ;;
esac
[[ -z "$TOOL_INPUT" ]] && exit 0

# Auto-detect morgan-ai-rules root. Installer can pre-set MORGAN_AI_RULES_ROOT
# via env to skip the search.
MORGAN_AI_RULES_ROOT="${MORGAN_AI_RULES_ROOT:-}"
if [[ -z "$MORGAN_AI_RULES_ROOT" ]]; then
  for cand in \
    "/d/workspace/morgan-ai-rules" \
    "/e/workspace/morgan-ai-rules" \
    "/c/workspace/morgan-ai-rules" \
    "$HOME/morgan-ai-rules" \
    "$HOME/workspace/morgan-ai-rules"; do
    if [[ -d "$cand/.git" ]]; then
      MORGAN_AI_RULES_ROOT="$cand"
      break
    fi
  done
fi

if [[ -z "$MORGAN_AI_RULES_ROOT" || ! -d "$MORGAN_AI_RULES_ROOT" ]]; then
  exit 0
fi
SCHEMA_LINT="$MORGAN_AI_RULES_ROOT/scripts/schema_lint.py"
[[ ! -r "$SCHEMA_LINT" ]] && exit 0

export MORGAN_AI_RULES_ROOT

python3 - "$TOOL_INPUT" "$MORGAN_AI_RULES_ROOT" "$SCHEMA_LINT" "$TOOL_NAME" <<'PY'
import json, os, sys, subprocess, pathlib
from datetime import datetime, timezone

# Phase 5 — shadow mode metric collection.
# VAULT_GOVERNANCE_MODE = "enforce" (default, backward compat) | "shadow"
# In shadow mode, non-PASS verdicts log a JSONL row and exit 0; R17 (cross-
# machine _global.md drift) is the永遠 enforce 後門 — its REJECT always halts
# regardless of mode, because R17 is a write-time precondition (rule-source
# freshness) rather than a rule content check.
# Per Phase 5 補5 拍板 A (Morgan 2026-05-12).
SCRIPT_VERSION = "phase5-v1"
SHADOW_LOG_DEFAULT = os.path.expanduser("~/.claude/logs/vault_governance_shadow.jsonl")
SHADOW_LOG_PATH = os.environ.get("VAULT_SHADOW_LOG_PATH", SHADOW_LOG_DEFAULT)
SHADOW_LOG_SIZE_CAP_BYTES = 50 * 1024 * 1024  # 50MB cap; warning-only, rotation Phase 9.


def _write_shadow_log(record: dict) -> bool:
    """Append one JSONL line; return True on success, False on any failure.

    Phase 5 紀律：caller fallback enforce (exit 2) on False (治理底線).
    """
    try:
        log_path = pathlib.Path(SHADOW_LOG_PATH)
        log_path.parent.mkdir(parents=True, exist_ok=True)
        line = json.dumps(record, ensure_ascii=False) + "\n"
        with open(log_path, "a", encoding="utf-8", newline="") as f:
            f.write(line)
    except OSError as exc:
        print(f"[VAULT-CHECK] shadow log write failed: {exc}", file=sys.stderr)
        return False

    # 50MB cap — warning-only, never blocks. Rotation Phase 9.
    try:
        size = log_path.stat().st_size
        if size > SHADOW_LOG_SIZE_CAP_BYTES:
            mb = size // (1024 * 1024)
            print(
                f"[VAULT-CHECK] shadow log size {mb}MB exceeds 50MB cap; "
                f"manual rotate (mv {SHADOW_LOG_PATH} {SHADOW_LOG_PATH}.bak) "
                f"or wait Phase 9 cron",
                file=sys.stderr,
            )
    except OSError:
        pass
    return True


tool_input_raw, root, schema_lint_path, tool_name = (
    sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4],
)

try:
    tool_input = json.loads(tool_input_raw)
except Exception:
    sys.exit(0)

file_path = tool_input.get("file_path", "") or ""
if not file_path:
    sys.exit(0)

fp_norm = file_path.replace("\\", "/").lower()
root_norm = root.replace("\\", "/").lower()

# In-scope determination:
#   1. file_path is under MORGAN_AI_RULES_ROOT (authoritative)
#   2. file_path contains "morgan-ai-rules/" (covers paths outside the
#      resolved root, e.g. another clone)
#   3. file_path is under a Vault OneDrive path
under_root = fp_norm.startswith(root_norm + "/") or fp_norm == root_norm
under_other_clone = "morgan-ai-rules/" in fp_norm
under_vault = "onedrive" in fp_norm and "vps-obsidian" in fp_norm
if not (under_root or under_other_clone or under_vault):
    sys.exit(0)

target_rel = file_path.replace("\\", "/")
if target_rel.lower().startswith(root_norm + "/"):
    target_rel = target_rel[len(root_norm) + 1:]
else:
    for vault_root in (
        "d:/onedrive/vps-obsidian/",
        "e:/onedrive/vps-obsidian/",
        "/d/onedrive/vps-obsidian/",
        "/e/onedrive/vps-obsidian/",
    ):
        if target_rel.lower().startswith(vault_root):
            target_rel = target_rel[len(vault_root):]
            break

op = "update" if pathlib.Path(file_path).exists() else "create"

content = tool_input.get("content") or ""
if not content:
    new_str = tool_input.get("new_string", "")
    old_str = tool_input.get("old_string", "")
    if new_str:
        try:
            existing = pathlib.Path(file_path).read_text(encoding="utf-8")
            if old_str and old_str in existing:
                content = existing.replace(old_str, new_str, 1)
            else:
                content = existing if existing else new_str
        except OSError:
            content = new_str
    else:
        try:
            content = pathlib.Path(file_path).read_text(encoding="utf-8")
        except OSError:
            content = ""

req = {
    "writer_role": "executor",
    "writer_engine": "claude",
    "target_path": target_rel,
    "operation": op,
    "content": content,
    "branch": "main",
    "morgan_ai_rules_root": root,
}

try:
    sub_env = os.environ.copy()
    sub_env["PYTHONIOENCODING"] = "utf-8"
    result = subprocess.run(
        [sys.executable, schema_lint_path],
        input=json.dumps(req, ensure_ascii=False),
        capture_output=True, text=True, timeout=10,
        encoding="utf-8",
        env=sub_env,
    )
except subprocess.TimeoutExpired:
    print("[VAULT-CHECK] schema_lint timeout (>10s) — fail-closed", file=sys.stderr)
    sys.exit(2)
except Exception as exc:
    print(f"[VAULT-CHECK] schema_lint invocation error: {exc}", file=sys.stderr)
    sys.exit(2)

try:
    verdict_obj = json.loads(result.stdout)
except Exception:
    print(f"[VAULT-CHECK] schema_lint output unparseable: {result.stdout[:200]}", file=sys.stderr)
    sys.exit(2)

verdict = verdict_obj.get("verdict", "")
rule = verdict_obj.get("fail_at_rule", "")
error_code = verdict_obj.get("error_code", "")
fix = verdict_obj.get("suggested_fix") or verdict_obj.get("human_summary_zh", "")

# PASS — short-circuit, identical in both modes.
if verdict == "PASS":
    sys.exit(0)

# Phase 5 — resolve mode. Unknown values fail-closed to enforce.
mode = os.environ.get("VAULT_GOVERNANCE_MODE", "enforce").strip().lower()
if mode not in ("enforce", "shadow"):
    print(
        f"[VAULT-CHECK] unknown VAULT_GOVERNANCE_MODE={mode!r}; fail-closed enforce",
        file=sys.stderr,
    )
    mode = "enforce"

# R17 永遠 enforce 後門 — cross-machine _global.md drift halts regardless of mode.
# R17 is a write-time precondition (rule-source freshness), not a rule-content
# judgement; observing lint outcomes on stale rules has no signal.
is_r17_drift = (rule == "R17")

if mode == "shadow" and not is_r17_drift:
    record = {
        "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "tool_name": tool_name,
        "target_path": target_rel,
        "verdict": verdict,
        "fail_at_rule": rule,
        "error_code": error_code,
        "suggested_fix": fix,
        "mode": "shadow",
        "script_version": SCRIPT_VERSION,
    }
    if not _write_shadow_log(record):
        # Log write failed → fallback enforce (治理底線).
        print(
            f"[VAULT-CHECK] shadow log write failed → fallback enforce ({rule}): {fix}",
            file=sys.stderr,
        )
        sys.exit(2)
    sys.exit(0)

# Enforce path (or R17 in any mode).
# Phase 5.5 caveat: Claude Code's PreToolUse hook exit 2 does NOT reliably
# block Edit/Write writes (known Anthropic issue, closed "not planned").
# We print explicit guidance so the Claude model (which DOES read stderr)
# can self-correct. The Phase 5.5 PostToolUse hook is the physical
# enforcement net that reverts via git checkout.
PHASE_5_5_CAVEAT = (
    "注意：Claude Code 對 Edit/Write 不可靠尊重 PreToolUse exit 2 (Anthropic known gap)。"
    " 你（Claude）若已讀到本訊息，請主動放棄本次寫入。"
    " 若仍寫入，Phase 5.5 PostToolUse hook 會自動 git revert。"
)

if verdict == "REJECT":
    print(f"[VAULT-CHECK] REJECT ({rule}): {fix}", file=sys.stderr)
    print(f"[VAULT-CHECK] {PHASE_5_5_CAVEAT}", file=sys.stderr)
    sys.exit(2)
if verdict == "NEEDS_HUMAN":
    print(f"[VAULT-CHECK] 需 Morgan in loop ({rule}): {fix}", file=sys.stderr)
    print("這次寫入屬於 ceremony 級操作，請先跟 Morgan 對齊後再執行。", file=sys.stderr)
    print(f"[VAULT-CHECK] {PHASE_5_5_CAVEAT}", file=sys.stderr)
    sys.exit(2)
print(f"[VAULT-CHECK] unknown verdict: {verdict}", file=sys.stderr)
sys.exit(2)
PY
